# Port for Express API Server
PORT=5000

# MongoDB Connection String
# Local Development (Works immediately if local MongoDB is installed):
MONGODB_URI=mongodb://localhost:27017/sportpulse_db

# Production Deployment (Replace with your free MongoDB Atlas URI):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/sportpulse_db?retryWrites=true&w=majority

# Environment
NODE_ENV=development
